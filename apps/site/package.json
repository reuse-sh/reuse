{
  "name": "@reuse-sh/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/generate-example-registry.mjs && node ../../scripts/prepare-examples.mjs && next dev --hostname 127.0.0.1 --port 4300",
    "build": "node ../../scripts/generate-example-registry.mjs && node ../../scripts/prepare-examples.mjs && next build",
    "start": "next start --hostname 127.0.0.1 --port 4300",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@pierre/highlights": "0.2.0",
    "@reuse-sh/annotations": "workspace:*",
    "@reuse-sh/avatars": "workspace:*",
    "@reuse-sh/carousel": "workspace:*",
    "@reuse-sh/catalog": "workspace:*",
    "@reuse-sh/core": "workspace:*",
    "@reuse-sh/gradients": "workspace:*",
    "@reuse-sh/interactions": "workspace:*",
    "@reuse-sh/lightbox": "workspace:*",
    "@reuse-sh/loaders": "workspace:*",
    "@reuse-sh/shadows": "workspace:*",
    "geist": "^1.9.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.3"
  }
