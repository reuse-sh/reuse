{
  "install": "pnpm install --frozen-lockfile",
  "servers": [
    {
      "name": "site",
      "command": "env REUSE_PORT={port} pnpm dev",
      "portRange": [4301, 4399]
    }
  ],
  "checks": [
    "pnpm lint",
    "pnpm type-check",
    "pnpm test",
    "pnpm build",
    "pnpm test:browser"
  ]
}
