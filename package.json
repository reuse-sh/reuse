{
  "name": "reuse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo watch dev --filter=@reuse-sh/site",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "test:browser": "playwright test",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm test:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "25.9.8",
    "jsdom": "30.1.1",
    "turbo": "2.11.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "license": "MIT"
}
