{
  "name": "@reuse-sh/shadows",
  "version": "0.0.3",
  "description": "A six-level CSS shadow scale with optional hairline rings.",
  "keywords": [
    "reuse",
    "shadow",
    "box-shadow",
    "css",
    "elevation"
  ],
  "homepage": "https://reuse.sh/shadows",
  "bugs": "https://github.com/reuse-sh/reuse/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reuse-sh/reuse.git",
    "directory": "packages/shadows"
  },
  "license": "MIT",
  "author": "nK <https://nkdev.info>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node ../../scripts/copy-styles.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
