{
  "name": "@reuse-sh/core",
  "version": "0.0.1",
  "description": "Small clipboard and HTML escaping utilities shared by the Reuse packages.",
  "keywords": [
    "reuse",
    "clipboard",
    "escape-html"
  ],
  "homepage": "https://reuse.sh",
  "bugs": "https://github.com/reuse-sh/reuse/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reuse-sh/reuse.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "nK <https://nkdev.info>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./clipboard": {
      "types": "./dist/clipboard.d.ts",
      "import": "./dist/clipboard.js"
    },
    "./escape-html": {
      "types": "./dist/escape-html.d.ts",
      "import": "./dist/escape-html.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node ../../scripts/copy-styles.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  }
}
