{
  "name": "@reuse-sh/interactions",
  "version": "0.0.1",
  "description": "A floating tooltip, a moving highlight, and a hold-to-confirm button for native and React interfaces.",
  "keywords": [
    "reuse",
    "tooltip",
    "highlight",
    "hold-to-confirm",
    "interaction"
  ],
  "homepage": "https://reuse.sh",
  "bugs": "https://github.com/reuse-sh/reuse/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reuse-sh/reuse.git",
    "directory": "packages/interactions"
  },
  "license": "MIT",
  "author": "nK <https://nkdev.info>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node ../../scripts/copy-styles.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.3.0",
    "@types/react": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
