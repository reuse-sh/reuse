{
  "name": "@reuse-sh/lightbox",
  "version": "0.1.1",
  "description": "An image lightbox on native scrolling, with thumbnail transitions, zoom, pan, and pinch.",
  "keywords": [
    "reuse",
    "lightbox",
    "gallery",
    "zoom",
    "image-viewer"
  ],
  "homepage": "https://reuse.sh/lightbox",
  "bugs": "https://github.com/reuse-sh/reuse/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reuse-sh/reuse.git",
    "directory": "packages/lightbox"
  },
  "license": "MIT",
  "author": "nK <https://nkdev.info>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base.css": "./dist/base.css",
    "./theme.css": "./dist/theme.css",
    "./themes/*": "./dist/themes/*",
    "./unlayered/*": "./dist/unlayered/*",
    "./browser/*": "./dist/browser/*",
    "./video": {
      "types": "./dist/video.d.ts",
      "import": "./dist/video.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "import": "./dist/audio.js"
    },
    "./iframe": {
      "types": "./dist/iframe.d.ts",
      "import": "./dist/iframe.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./carousel": {
      "types": "./dist/carousel.d.ts",
      "import": "./dist/carousel.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node ../../scripts/copy-styles.mjs && node ../../scripts/build-browser.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "19.3.0",
    "@types/react": "19.3.0"
  },
  "dependencies": {
    "@reuse-sh/carousel": "workspace:*",
    "@reuse-sh/loaders": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
