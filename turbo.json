{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/modules/**",
        "public/fonts/**",
        ".cn/**",
        "public/styles/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalDependencies": [
    "tsconfig.base.json",
    "scripts/*.mjs",
    "scripts/*.json"
  ],
  "globalPassThroughEnv": ["REUSE_PORT", "REUSE_TEST_PORT"]
}
